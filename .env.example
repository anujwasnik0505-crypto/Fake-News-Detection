# Copy this file to ".env" and fill in whichever keys you have.
# Every key below is OPTIONAL -- if left blank, that layer is automatically
# skipped and the project still works using its free fallbacks.

# NewsAPI.org -- live news verification (free tier: https://newsapi.org/register)
# Falls back to free Google News RSS search if not set.
NEWSAPI_KEY=

# Google Fact Check Tools API -- checks professional fact-checker databases
# Free, get a key at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_API_KEY=

# LLM plausibility reasoning layer -- set ONE of these two (Gemini is tried first):

# Google Gemini -- FREE tier (15 req/min, 1500 req/day): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude -- free trial credits, then paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
